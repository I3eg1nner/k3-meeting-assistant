MEETING_DATA_DIR=.data
MEETING_STATIC_DIR=backend/static
MEETING_API_TOKEN=
ALLOW_DEGRADED=true

# K3 local llama.cpp text model
LOCAL_LLM_URL=http://127.0.0.1:8081/v1
LOCAL_LLM_MODEL=Qwen3-4B
LOCAL_LLM_MODEL_PATH=/var/lib/meeting-assistant/models/Qwen3-4B-Q4_K_M.gguf
LLAMA_SERVER_BIN=llama-server

# K3-local multimodal model (text GGUF + SMT vision ONNX in one directory)
LOCAL_VLM_URL=http://127.0.0.1:18086/v1
LOCAL_VLM_MODEL=Qwen3.5-2B
LOCAL_VLM_MODEL_PATH=/var/lib/meeting-assistant/models/vlm/Qwen3.5-2B/qwen3_5_2b-text-q41.gguf
LOCAL_VLM_MODEL_DIR=/var/lib/meeting-assistant/models/vlm/Qwen3.5-2B

# Model command adapters must print JSON or write the {output} path.
ASR_COMMAND=python3 /opt/meeting-assistant/scripts/k3_asr_adapter.py --input {input} --output {output}
DIARIZATION_COMMAND=python3 /opt/meeting-assistant/scripts/k3_diarization_adapter.py --input {input} --output {output}
OCR_COMMAND=python3 /opt/meeting-assistant/scripts/k3_ocr_adapter.py --input {input} --output {output}
VLM_COMMAND=

# Optional OpenAI-compatible review backend
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_TEXT_MODEL=
CLOUD_VISION_MODEL=
CLOUD_ASR_MODEL=

MIN_MEM_AVAILABLE_MB=512
MAX_MODEL_RSS_MB=6349
MAX_UPLOAD_BYTES=2147483648
